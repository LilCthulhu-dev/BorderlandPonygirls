[resource]
script = ExtResource("2_yda4m")
flavor_lines = Array[String](["Loose stones shift under your boots.", "The tunnel walls are scarred with old weapon marks.", "A cold wind blows through the passage."])
description = "The tunnel narrows until you must move in single file. Whispered voices echo ahead. Suddenly javelins fly from cracks in the stone and ambushers rush the passage.
"
actions = Array[ExtResource("1_l6ef7")]([SubResource("Resource_y26au"), SubResource("Resource_nhw4o"), SubResource("Resource_tadkw"), SubResource("Resource_yihxe")])
