[resource]
script = ExtResource("2")
title = "Kidnap Camp"
difficulty_penalty = 0
scenes = Array[ExtResource("1")]([ExtResource("4"), ExtResource("5"), ExtResource("6")])
enemy_descriptors = Array[String](["Sneaking", "Cheap", "Mean", "Nervous", "Hired"])
enemy_names = Array[String](["Slavers", "Kidnappers", "Handlers", "Buyers"])
victory_actions = Array[ExtResource("3")]([SubResource("Resource_held"), SubResource("Resource_spawn"), SubResource("Resource_vgold"), SubResource("Resource_vrep")])
defeat_actions = Array[ExtResource("3")]([SubResource("Resource_dgold")])
victory_txt = "The camp breaks. You cut the traces and take the lead. The mare does not thank you. She only shakes, bit still in, eyes on the trees.

You have her. What she is - runaway, cargo, or someone who never agreed to the tack - is a question for after the fire dies."
defeat_txt = "They drive you off the firelight. The mare is still in the traces when you fall back to the road. The trail is not gone. Come back when you can stand."
victory_img = ExtResource("13")
defeat_img = ExtResource("14")
metadata/_custom_type_script = "uid://ct66od486dv7w"
