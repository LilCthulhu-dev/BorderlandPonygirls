[resource]
script = ExtResource("3_p74rx")
title = "Ponygirl Race"
enemy_descriptors = Array[String](["Fierce", "Tough", "Skilled", "Determined", "Experienced", "Relentless"])
enemy_names = Array[String](["Rivals", "Racers", "Competitors", "Opponents"])
victory_actions = Array[ExtResource("1_srjtg")]([SubResource("Resource_xicot"), SubResource("Resource_xmjim"), SubResource("Resource_jj2a4")])
victory_txt = "{PONYNAME} is drenched in sweat, her naked tits heaving with exhaustion - but you won! The finishing ribbon snaps onto her chest harnish as the crowd erupts in celebration.

The race master comes over after you have bathed in the applause for a while, grinning as he hands you a big pouch with coin.

It was a good race. The field will remember both you and {PONYNAME}."
defeat_txt = "You drive {PONYNAME} across the finish line, but the others were faster. They are already bathing in the crowd’s adoration.

You can only watch with envy as the winner receives the prize money. Still, it was a clean loss. You and your ponygirl are exhausted, but unharmed. Next time you will be the one celebrating!"
metadata/_custom_type_script = "uid://ct66od486dv7w"
