[resource]
script = ExtResource("2")
title = "Ponygirl Race"
difficulty_penalty = 0
scenes = Array[ExtResource("1")]([ExtResource("4"), ExtResource("5"), ExtResource("6"), ExtResource("7"), ExtResource("8")])
enemy_descriptors = Array[String](["Fierce", "Tough", "Skilled", "Determined", "Experienced", "Relentless"])
enemy_names = Array[String](["Rivals", "Racers", "Competitors", "Opponents"])
victory_actions = Array[ExtResource("3")]([SubResource("Resource_vgold"), SubResource("Resource_vrep"), SubResource("Resource_varo")])
defeat_actions = Array[ExtResource("3")]([SubResource("Resource_dgold"), SubResource("Resource_daro")])
victory_txt = "The ribbon hits {PONYNAME}’s chest. For a moment the roar is only for you. Stewards count the purse into your hand while your mare stands blowing, eyes bright, still wanting another furlong.

It was a good race. The field will remember the name on her bit-ring."
victory_img = ExtResource("12")
defeat_txt = "You fade before the post. {PONYNAME} still finishes - she is too proud not to - but the fierce ones are already being walked out under wreaths.

The stewards pay appearance coin and look past you. Soft loss. No one died. The next meet will not wait."
metadata/_custom_type_script = "uid://ct66od486dv7w"
