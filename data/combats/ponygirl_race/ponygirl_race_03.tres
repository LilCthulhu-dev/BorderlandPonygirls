[gd_resource type="Resource" script_class="CombatScene" format=3 uid="uid://cscenprace03"]

[ext_resource type="Script" uid="uid://c62fr7oiolt4o" path="res://data/combats/combat_action.gd" id="1"]
[ext_resource type="Script" uid="uid://c1qiogsydlipg" path="res://data/combats/combat_scene.gd" id="2"]

[sub_resource type="Resource" id="Resource_a"]
script = ExtResource("1")
txt = "Hold her on the edge"
ability = 3
success_description = "You take the reins short and give her nothing. {PONYNAME} sobs around the bit, shaking, but she keeps her feet. The rival who already went over has to be hauled aside. You pass her."
fail_description = "She is already too far gone. {PONYNAME} locks up mid-stride, climax ripping through her, and the pack swallows you while she twitches in the traces."
metadata/_custom_type_script = "uid://c62fr7oiolt4o"

[sub_resource type="Resource" id="Resource_b"]
script = ExtResource("1")
txt = "Let her finish, then run"
ability = 2
success_description = "You let {PONYNAME} have it - one hard, shaking peak - then boot her back into the race while the others are still deciding whether to follow. Half the field breaks stride watching."
fail_description = "The moan goes through the pack like a spark. Two rivals give in at once. The track becomes a mess of locked knees and ruined timing, and you are in the middle of it."
metadata/_custom_type_script = "uid://c62fr7oiolt4o"

[sub_resource type="Resource" id="Resource_c"]
script = ExtResource("1")
txt = "Snap her out of it"
ability = 1
success_description = "A sharp check on the bit and a handful of water from the rail-bucket. {PONYNAME} gasps, eyes clearing just enough to run. The urge is still there. She runs anyway."
fail_description = "The yank only pushes her over. She cries out, knees dipping, and you spend precious seconds keeping her off the dirt."
metadata/_custom_type_script = "uid://c62fr7oiolt4o"

[sub_resource type="Resource" id="Resource_d"]
script = ExtResource("1")
txt = "Ride the wave"
ability = 5
success_description = "You do not fight the shiver. You time her strides to it. {PONYNAME} comes through the worst of it still moving, and a rival who tried to copy her loses the plot entirely."
fail_description = "You misread her. The wave hits on the wrong foot. {PONYNAME} stumbles, and the determined mare on your girth takes the gap."
metadata/_custom_type_script = "uid://c62fr7oiolt4o"

[resource]
script = ExtResource("2")
flavor_lines = Array[String](["Someone used the carrot too freely before the start.", "A moan rolls down the field; several pairs of ears flick back.", "The scent of heat is thicker than dust.", "{PONYNAME}’s stride has gone uneven, hungry."])
description = "A rider ahead used too much carrot - or worked their mare too high before the start. She goes over the edge mid-race, climaxing hard enough that the others can hear it. Now every racer has to find the mental focus to keep running, or give in and try to finish too. {PONYNAME} is right on that same knife-edge."
actions = Array[ExtResource("1")]([SubResource("Resource_a"), SubResource("Resource_b"), SubResource("Resource_c"), SubResource("Resource_d")])
metadata/_custom_type_script = "uid://c1qiogsydlipg"
