[sub_resource type="Resource" id="Resource_muscle"]
script = ExtResource("1")
txt = "Break for the light"
ability = 1
success_description = "You smash a path to the mouth and drag both crates into the sun."
fail_description = "You make the mouth. The inner crate does not."
metadata/_custom_type_script = "uid://c62fr7oiolt4o"

[sub_resource type="Resource" id="Resource_wits"]
script = ExtResource("1")
txt = "Watch the walls"
success_description = "You catch the second rush on the turn and keep the iron moving."
fail_description = "A side tunnel opens that was not there. You drop weight to stay alive."
metadata/_custom_type_script = "uid://c62fr7oiolt4o"

[sub_resource type="Resource" id="Resource_sway"]
script = ExtResource("1")
txt = "Shout them off"
ability = 2
success_description = "Your voice fills the stone. Whatever hunts here decides you are more trouble than shoes."
fail_description = "The echo comes back wrong. They are not impressed."
metadata/_custom_type_script = "uid://c62fr7oiolt4o"

[resource]
script = ExtResource("2")
img = ExtResource("3")
flavor_lines = Array[String](["Daylight is a thin coin at your back.", "The first crate still sits in the gravel.", "Claws click on wet stone."])
description = "The fight spills toward the cave mouth. If you lose the inner crate here, the smiths will never know it existed."
actions = Array[ExtResource("1")]([SubResource("Resource_muscle"), SubResource("Resource_wits"), SubResource("Resource_sway")])
