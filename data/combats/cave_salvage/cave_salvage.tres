[resource]
script = ExtResource("2")
title = "Cave Salvage"
scenes = Array[ExtResource("1")]([ExtResource("7_saron"), ExtResource("8_imhph"), ExtResource("9_imhph")])
enemy_descriptors = Array[String](["Hungry", "Pale", "Territorial"])
enemy_names = Array[String](["Land-Squid"])
victory_txt = "The land-squid’s tentacles thrash weakly across the cave floor before finally going limp. The creature releases one last shuddering breath, and then the cave falls silent.

You have slain the land-squid!"
victory_img = ExtResource("10")
victory_actions = Array[ExtResource("5")]([SubResource("Resource_win_flags")])
defeat_txt = "The land-squid surges forward, its tentacles scattering your battered warband. With several of your men already wounded and the others struggling to hold their ground, you order a retreat.

Your men drag the injured with them as you flee toward the cave entrance, scattering into the wild."
defeat_img = ExtResource("11")
