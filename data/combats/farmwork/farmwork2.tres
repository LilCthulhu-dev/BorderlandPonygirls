[sub_resource type="Resource" id="Resource_dt1kr"]
script = ExtResource("1_1hj28")
txt = "Deny the Pause"
ability = 1
success_description = "You take up your crop, step behind the lazy mare, and work over her ass and thighs until she is pulling hard and eagerly again."
fail_description = "You strike {PONYNAME} with your crop, but it motivates her only briefly. Before long, exhaustion overwhelms her, and she collapses to her knees.
"
