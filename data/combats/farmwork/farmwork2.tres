[sub_resource type="Resource" id="Resource_sdmun"]
script = ExtResource("1_1hj28")
txt = "Short Pause"
ability = 3
success_description = "You lead {PONYNAME} into the shade and rinse her down with cool water. It is a brief but well-deserved break, and she returns to work with renewed strength.

"
fail_description = "You give {PONYNAME} a brief rest in the shade, but she balks when the work resumes. The pause only seems to have made her even more resistant."
metadata/_custom_type_script = "uid://c62fr7oiolt4o"

[sub_resource type="Resource" id="Resource_1riha"]
script = ExtResource("1_1hj28")
txt = "Reassure and Guide"
ability = 3
success_description = "You give {PONYNAME} a few sips of water, take the reins, and guide her forward with calm praise. Your presence steadies her, and she begins pulling the plow again."
fail_description = "You give {PONYNAME} some water and try to guide her onward, but she is too exhausted to continue. You have no choice but to stop and let her rest properly."
metadata/_custom_type_script = "uid://c62fr7oiolt4o"

[resource]
