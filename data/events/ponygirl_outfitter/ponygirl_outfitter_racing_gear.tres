[sub_resource type="Resource" id="Resource_dsa86"]
script = ExtResource("4_dsa86")
txt = "The shopkeeper still seems to consider ponygirl racing a foolish waste of good craftsmanship, but he accepts your coin without making a fuss.

He measures each of your mares carefully, grumbling whenever one of them fidgets, then talks you through the available materials, colors, and fittings. Once every detail has been settled, he tells you to return the following day.

True to his word, the racing gear is ready when you come back. The finished harnesses and saddles are surprisingly light, with slender straps, polished fittings, and just enough decoration to catch the crowd’s attention without weighing the mares down."
metadata/_custom_type_script = "uid://cjt27rj7fiwsv"

