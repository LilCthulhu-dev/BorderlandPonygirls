[resource]
script = ExtResource("3_vbjus")
titel = "Ponygirl outfitter"
description = "You ask the owner about gear for ponygirl racing.

“You’re interested in that new fad, {TITLE}?” the shopkeeper asks dismissively. “A waste, if you ask me. The gear is difficult to make, and young riders keep training for the track instead of the grasslands. But what do I know?”

He coughs, then gives you a reluctant nod. “Still, I can make you the saddle and harness. I even have the proper dildos and plugs imported from the south. But it’ll cost you.”"
content = Array[ExtResource("2_nsns3")]([SubResource("Resource_of4kn"), SubResource("Resource_kg44k")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
