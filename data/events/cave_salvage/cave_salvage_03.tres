[resource]
script = ExtResource("11_cj73r")
titel = "Cave Salvage"
description = "Your men unload the salvaged goods while you speak with the guard captain and explain what you found.

“Again?” she growls, shaking her head. “Smuggling has really been getting out of hand lately. Anyhow, thanks for returning the stolen goods - and for giving me a heads-up.”

She barks a few orders, and a short while later, the recovered goods are carried into the guardhouse. In return, you receive a pouch of freshly minted imperial coins."
img = ExtResource("10_kccds")
content = Array[ExtResource("6_0as8r")]([SubResource("Resource_0k4vp"), SubResource("Resource_r687m"), SubResource("Resource_3gffg")])
open_actions = Array[ExtResource("1_w4e4u")]([SubResource("Resource_trsao")])
close_actions = Array[ExtResource("1_w4e4u")]([SubResource("Resource_s5ama")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
