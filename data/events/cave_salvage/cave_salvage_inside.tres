[sub_resource type="Resource" id="Resource_to_take"]
script = ExtResource("4")
event_path = "res://data/events/cave_salvage/cave_salvage_take_inner.tres"
metadata/_custom_type_script = "uid://low1eg5crao3"

[sub_resource type="Resource" id="Resource_flags"]
script = ExtResource("8")
add_flag = Array[ExtResource("5")]([ExtResource("6"), ExtResource("7")])
metadata/_custom_type_script = "uid://ta4rmpl13bdw"

[sub_resource type="Resource" id="Resource_take"]
script = ExtResource("3")
txt = "Grab the inner crate and run"
actions = Array[ExtResource("1")]([SubResource("Resource_to_take"), SubResource("Resource_flags")])
metadata/_custom_type_script = "uid://0o5ru8obqsel"

[sub_resource type="Resource" id="Resource_combat"]
script = ExtResource("9")
combat = ExtResource("10")
metadata/_custom_type_script = "uid://bnjeril1f2cy8"

[sub_resource type="Resource" id="Resource_push"]
script = ExtResource("3")
txt = "Clear the chamber"
actions = Array[ExtResource("1")]([SubResource("Resource_combat")])
metadata/_custom_type_script = "uid://0o5ru8obqsel"

[sub_resource type="Resource" id="Resource_to_start"]
script = ExtResource("4")
event_path = "res://data/events/cave_salvage/cave_salvage_start.tres"
metadata/_custom_type_script = "uid://low1eg5crao3"

[sub_resource type="Resource" id="Resource_leave"]
script = ExtResource("3")
txt = "Back to the mouth"
actions = Array[ExtResource("1")]([SubResource("Resource_to_start")])
metadata/_custom_type_script = "uid://0o5ru8obqsel"

[resource]
script = ExtResource("11")
titel = "Cave Salvage"
description = "The mouth crate was overflow. Ten steps in: a second box, half-packed, imperial shoes still oiled. Charcoal on the wall. A bed of rags that is not old.

Something in the next chamber clicks its teeth when your lantern moves."
img = ExtResource("12")
content = Array[ExtResource("2")]([SubResource("Resource_take"), SubResource("Resource_push"), SubResource("Resource_leave")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
