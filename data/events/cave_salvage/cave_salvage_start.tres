metadata/_custom_type_script = "uid://ta4rmpl13bdw"

[resource]
script = ExtResource("9")
titel = "Cave Salvage"
description = "At a cave mouth off the track you find a spilled crate: rusted horseshoes, a cracked lantern, a broken bit still dark with old spit.

A charcoal arrow on the lid points south. Someone meant this for the Trading Post smiths and did not finish the walk."
img = ExtResource("10")
content = Array[ExtResource("2")]([SubResource("Resource_inspect"), SubResource("Resource_accept"), SubResource("Resource_decline")])
open_actions = Array[ExtResource("1")]([SubResource("Resource_gate")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
