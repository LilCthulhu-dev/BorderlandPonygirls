[sub_resource type="Resource" id="Resource_tkrab"]
script = ExtResource("5_hvbpj")
ability = 3
succes_actions = Array[ExtResource("1_2yvm8")]([SubResource("Resource_kc2dl")])
fail_actions = Array[ExtResource("1_2yvm8")]([SubResource("Resource_4wduo")])
txt = "Salvage crate."
succes_txt = "You hush your men, then quietly order them to retrieve the crate and strap it to the back of one of their ponygirls.

One of your men knocks a loose stone across the cave floor. Everyone freezes as the sound echoes through the tunnels.

Thankfully, the beast does not seem to have noticed. Your men finish securing the crate."
fail_txt = "Your men do their best to work quietly, but suddenly, the sounds from deeper within the cave fall silent.

You order them to halt. A moment later, a hulking land-squid bursts from the tunnel and into the light of your torches, screeching as its tentacles lash out at your men."
metadata/_custom_type_script = "uid://b7vmcwnbxge0e"

[sub_resource type="Resource" id="Resource_pn22d"]
script = ExtResource("10_i6dqv")
txt = "You signal your men to remain quiet and slowly lead them deeper into the tunnel. The sickening sounds of something large feeding grow louder with every step.

Eventually, you spot the creature ahead: a giant land-squid squatting in the middle of the tunnel, chewing on the carcass of a dead goblin.

You hold your breath, wondering whether you truly want to challenge it. Then one of your she-beasts lets out a terrified whine.

The land-squid looks up. Now you have to fight."
metadata/_custom_type_script = "uid://cjt27rj7fiwsv"

