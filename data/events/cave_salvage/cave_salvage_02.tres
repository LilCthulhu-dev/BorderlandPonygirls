[resource]
script = ExtResource("11_081s4")
titel = "Cave Salvage"
description = "You dismount and take your ponygirl by the reins as your men follow you into the darkness of the cave.

The air inside is cold and damp. From somewhere deep below comes the sound of a large creature noisily slurping and crunching its way through a meal.

You weigh your options, unsure whether venturing deeper is worth the risk. Then you notice another mostly intact crate lying just inside the nearest tunnel."
img = ExtResource("10_mlicy")
content = Array[ExtResource("2_yokwc")]([SubResource("Resource_tkrab"), SubResource("Resource_2q2b3"), SubResource("Resource_nm15e")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
