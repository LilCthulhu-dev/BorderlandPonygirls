[sub_resource type="Resource" id="Resource_u2vlh"]
script = ExtResource("6_6bce0")
_btn_text = "Search the debris."
_modal_text = "Your men dismount and begin searching through the debris. Most of it is junk, but one crate appears to have survived intact - and it bears an imperial stamp.

“Smugglers,” one of your men growls. “Why else would they carry official goods through the wilderness?”

“Seems about right,” you reply before ordering your men to load the crate. “The guards at the trading post might pay good coin for its return.”"
actions = Array[ExtResource("1_8qhdw")]([SubResource("Resource_aoeo5")])
metadata/_custom_type_script = "uid://dwjwfrh5b5rjt"

