[resource]
script = ExtResource("9")
titel = "Tide Fish"
description = "A fishmonger with scale-flecked arms blocks your path at the docks.

“{TITLE}. Halfling Village wants a load of tide-fish before it turns. Fast wagon, wet straw, pay on delivery. Your mares look like they can make the road.”"
img = ExtResource("10")
content = Array[ExtResource("2")]([SubResource("Resource_g7qhn"), SubResource("Resource_accept"), SubResource("Resource_decline")])
open_actions = Array[ExtResource("1")]([SubResource("Resource_gate")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
