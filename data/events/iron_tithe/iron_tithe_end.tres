[resource]
script = ExtResource("7")
titel = "Iron Tithe"
img = ExtResource("8")
description = "The post smith checks the village mark, hefts a bar, and nods. “Good iron. We’ll turn it into bits and buckle-tongues before the week is out.”

He pays the tithe-fee without haggling. “Tell the elder the next batch can wait until the rains stop.”"
open_actions = Array[ExtResource("1")]([SubResource("Resource_flag"), SubResource("Resource_gold"), SubResource("Resource_repute")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
