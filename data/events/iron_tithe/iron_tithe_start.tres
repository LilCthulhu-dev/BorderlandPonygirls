[sub_resource type="Resource" id="Resource_4pj2e"]
script = ExtResource("3_r488r")
_btn_text = "Inspect the wagon"
_modal_text = "The bars are village-smelted, stamped with a crude horseshoe. Enough for a season of bits, buckles, and spare rings.

Heavy, but your mares can pull it. Losing even one bar on the road would be noticed."

[sub_resource type="Resource" id="Resource_to_accept"]
script = ExtResource("5")
event_path = "res://data/events/iron_tithe/iron_tithe_accept.tres"
