[resource]
script = ExtResource("9")
titel = "Iron Tithe"
description = "A village elder stops you by the smithy, a low wagon of iron bars behind him.

“{TITLE}. The Trading Post wants its tithe in iron, not excuses. Haul this load south. They pay the fee there. We keep the village in tack.”"
img = ExtResource("10")
content = Array[ExtResource("2")]([SubResource("Resource_4pj2e"), SubResource("Resource_accept"), SubResource("Resource_decline")])
open_actions = Array[ExtResource("1")]([SubResource("Resource_gate")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
