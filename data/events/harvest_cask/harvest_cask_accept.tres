script = ExtResource("1")
titel = "Harvest Cask"
img = ExtResource("2")
description = "The farmer lashes the cask behind your lead mare and pats the wood. “Harbor inn, the one with the blue awning. Don’t bounce it. Don’t tap it. They pay when the seal is whole.”"
