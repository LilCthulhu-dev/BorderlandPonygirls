metadata/_custom_type_script = "uid://0o5ru8obqsel"

[sub_resource type="Resource" id="Resource_gate"]
script = ExtResource("8")
forbidden_flag = Array[ExtResource("6")]([ExtResource("7")])
metadata/_custom_type_script = "uid://ta4rmpl13bdw"

[resource]
script = ExtResource("9")
titel = "Harvest Cask"
description = "A halfling farmer waves you over from a cellar door, a sealed wine cask at his feet.

“{TITLE}. Harbor feast next week, and their inn is dry. Haul this cask to the house with the blue awning. Pay on delivery if the seal holds.”"
img = ExtResource("10")
content = Array[ExtResource("2")]([SubResource("Resource_haqby"), SubResource("Resource_accept"), SubResource("Resource_decline")])
open_actions = Array[ExtResource("1")]([SubResource("Resource_gate")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
