[resource]
script = ExtResource("3_xfjde")
titel = "Pony Panic"
description = "You’re in the middle of a busy road, as suddenly {PONYNAME} begins to buckle and thrash like a furious bull. Her rider is thrown off, but your men react fast and form a ring around her.

She kicks and screams, fights against her bondage with desperation while tears well up her eyes. You have seen it before: pony panic. The person surfaces, and struggles against her new life as your beast."
content = Array[ExtResource("2_42mhs")]([SubResource("Resource_twx8p"), SubResource("Resource_4b7ge"), SubResource("Resource_sxkb8")])
open_actions = Array[ExtResource("1_ie7op")]([SubResource("Resource_xfjde")])
