[resource]
script = ExtResource("4_10d22")
titel = "Pony Panic"
description = "“Enough! Stop at once!”

You uncoil your whip and {PONYNAME} eyes go wide. She knows what is coming and staggers back, but you are too fast. You let the whip crack, smack her back and ass, until she collapses into a whimpering pile.

Your men pull her up onto her knees, and you give her five more lashes as punishment, before you turn to the rest of the warband. “I don’t tolerate outbursts like that! Understood?”"
open_actions = Array[ExtResource("1_j2mad")]([SubResource("Resource_2m2l3"), SubResource("Resource_xb5im"), SubResource("Resource_nnt7c")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
