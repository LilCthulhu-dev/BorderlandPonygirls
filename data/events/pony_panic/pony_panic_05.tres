[resource]
script = ExtResource("3_arf2b")
titel = "Pony Panic"
description = "You give her a few moments to calm down, then you announce the punishment: five lashes.

{PONYNAME} whimpers helplessly, looks pleadingly at you. Your men bring a whip, and bent {PONYNAME} over an empty barrel. You aim for her juicy arse and lower back, every hit followed by a painful wail.

The onlookering townsfolk watch with a mix of terror and fascination."
open_actions = Array[ExtResource("1_c625b")]([SubResource("Resource_6y87a"), SubResource("Resource_m0k2t")])
