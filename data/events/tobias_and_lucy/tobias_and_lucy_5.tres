[resource]
script = ExtResource("7_ssrab")
titel = "Tobias and Lucy"
description = "You get up just as Tobias raises the mug to his lips, gulping down his beer with obvious enthusiasm. Lucy rolls her eyes and offers you a submissive bow of her head.

“It was a pleasure meeting you, {NAME}. Hopefully, we’ll see you at the track?”

Tobias takes a deep breath, his cheeks flushed from the alcohol. He burps, then gives you an apologetic smirk. “Sorry. Uh... good brew.”

He shakes your hand with a grin and nods. “It was good talking to you. And Lucy’s right - come by the track when you get the chance. The next race should be held near some kind of halfling village to the east.”"
content = Array[ExtResource("2_6l0hj")]([SubResource("Resource_qsvk6")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
