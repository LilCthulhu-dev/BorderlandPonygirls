[resource]
script = ExtResource("8_whhgj")
titel = "Tobias and Lucy"
_description = "“Yes, races,” Tobias exclaims before taking a deep drink of his beer. “Don’t tell me you’ve never been to one! Well, to be fair, the sport is still rather new, but back in the Empire, it’s the hottest thing around.”

“People pay good money to watch,” Lucy adds. You still can’t help but feel strange being addressed so casually by a ponygirl. “The racers have to pay an entry fee, but the winner takes home a hefty pouch of coin.”

“Word is, there’s a new league here in the Borderlands. Fresh blood, fewer rules, and it hasn’t been dominated by professional jockeys and mares yet. That’s why we’re trying our luck.”"
content = Array[ExtResource("2_7swbf")]([SubResource("Resource_lu3ck")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
