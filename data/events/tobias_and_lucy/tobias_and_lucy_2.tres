[resource]
script = ExtResource("8_nytj0")
titel = "Tobias and Lucy"
description = "Curiosity gets the better of you, and you walk over to greet the pair. You address the halfling first, hesitating briefly before nodding to the unusual ponygirl.

The pair chuckle at your uncertainty, but return your greeting and invite you to sit down and share a beer with them.

“Don’t worry, {TITLE},” the halfling says. “You’re not the first to get confused. I’m Tobias, and this pretty filly is Lucy. She’s a free woman, and I’m her jockey. We’re here to enter a few races and see if we can win some prize money.”"
content = Array[ExtResource("2_1hyxp")]([SubResource("Resource_lu3ck")])
open_actions = Array[ExtResource("1_cxpcb")]([SubResource("Resource_mm5oj")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
