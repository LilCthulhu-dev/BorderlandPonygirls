[resource]
script = ExtResource("3")
titel = "Ponygirl Race"
img = ExtResource("8")
description = "Harbor race-day. A dirt oval, a rope start, a purse nailed to a board, and a field of warband mares already hot in the traces.

A steward looks your string over. “{TITLE}. One mare, one rider. No drawing blades on the track. Purse to first. Appearance coin if you finish on your feet.”"
content = Array[ExtResource("1")]([SubResource("Resource_enter"), SubResource("Resource_pass")])
