[resource]
script = ExtResource("6")
titel = "Stable Fair"
_description = "A traveling stable fair has set up pens at the edge of the post. Handlers walk trained ponygirls in tight circles so buyers can judge gait, submission, and spirit.

Mares are offered by type - submission, training, and temper - not by famous names. Each visit brings different stock."
