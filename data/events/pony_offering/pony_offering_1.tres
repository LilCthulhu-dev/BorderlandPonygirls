[resource]
script = ExtResource("9_rw3tq")
titel = "Offering"
description = "A young woman approaches you, practically trembling with nervous excitement.

“Excuse me, {TITLE}. You are the leader of this warband, right?” She draws a steadying breath. “I would like to offer myself as a ponygirl. Pay my family a fair price, and I am yours.”"
