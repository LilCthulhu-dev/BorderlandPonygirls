[sub_resource type="Resource" id="Resource_lhi8g"]
script = ExtResource("3_3kwtb")
_btn_text = "Take a closer look"
_modal_text = "She looks young, healthy, and strong. Nervous, certainly, but that is normal. You also noticed the hunger in her eyes - the idea of becoming a pony clearly turns her on. She will probably struggle for a bit, but otherwise make a fine mare."

