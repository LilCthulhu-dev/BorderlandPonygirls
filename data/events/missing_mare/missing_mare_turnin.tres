txt = "Walk her away"
actions = Array[ExtResource("1")]([SubResource("Resource_add"), SubResource("Resource_rep_bad"), SubResource("Resource_kept")])
metadata/_custom_type_script = "uid://0o5ru8obqsel"

[sub_resource type="Resource" id="Resource_sway"]
script = ExtResource("14")
ability = 2
txt = "Shame him in the yard"
succes_txt = "You say it loud enough for the stalls: fresh tack, gag marks, a crew on the inland road. The merchant’s smile dies. He still wants her. The yard will remember he bought a kidnapping."
fail_txt = "He talks over you. A boss with a string of mares accusing a buyer of theft - the yard laughs it off."
metadata/_custom_type_script = "uid://b7vmcwnbxge0e"

[sub_resource type="Resource" id="Resource_trick"]
script = ExtResource("14")
ability = 4
txt = "Squeeze him for more"
succes_txt = "You mention the buyer-wax and the second crew. He pays extra to make you quiet. The extra is already in the purse."
fail_txt = "He goes stiff. No extra coin. He will still take her if you hand her over."
succes_actions = Array[ExtResource("1")]([SubResource("Resource_pay_extra")])
metadata/_custom_type_script = "uid://b7vmcwnbxge0e"

[resource]
script = ExtResource("9")
titel = "Missing Mare"
img = ExtResource("10")
description = "The merchant sees the mare and reaches for the lead like she is a crate.

“Good. Good. I’ll take her.” He does not ask if she ran. He does not look at the gag-sores. The wax on his sketch matches the token from the camp."
content = Array[ExtResource("2")]([SubResource("Resource_sway"), SubResource("Resource_trick"), SubResource("Resource_hand"), SubResource("Resource_walk")])
open_actions = Array[ExtResource("1")]([SubResource("Resource_gate")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
