[resource]
script = ExtResource("1")
titel = "Missing Mare"
img = ExtResource("2")
description = "The merchant presses a cheap sketch into your hand: a dark-haired human mare, bit-scarred, last seen on the harbor road.

“Harbor first. If the watch has her, pay the fine and bring her. If someone else has her… I still want her. I’ll pay well. Keep her and I’ll make sure every stall on this post hears about it.”"
