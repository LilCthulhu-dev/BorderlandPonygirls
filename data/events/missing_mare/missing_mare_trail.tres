[sub_resource type="Resource" id="Resource_gate"]
script = ExtResource("8")
required_flag = Array[ExtResource("4")]([ExtResource("5")])
forbidden_flag = Array[ExtResource("4")]([ExtResource("6"), ExtResource("7")])
metadata/_custom_type_script = "uid://ta4rmpl13bdw"

[sub_resource type="Resource" id="Resource_watch"]
script = ExtResource("12")
txt = "A watchman with fish-scales on his boots jerks a thumb inland.

“Second goblin crew last night. Not a local string. They had a dark-haired mare in new tack, gagged. Didn’t stop at the sheds. Took the wilderness road.”"
metadata/_custom_type_script = "uid://cjt27rj7fiwsv"

[sub_resource type="Resource" id="Resource_ask"]
script = ExtResource("3")
txt = "Ask the watch"
actions = Array[ExtResource("1")]([SubResource("Resource_watch")])
metadata/_custom_type_script = "uid://0o5ru8obqsel"

[sub_resource type="Resource" id="Resource_wits"]
script = ExtResource("11")
ability = 5
txt = "Search the net-sheds"
succes_txt = "No mare. There is a torn blinder in the mud and a buyer-wax drip on a post - the same stamp as the merchant’s sketch. She was never waiting here to be collected. She was moved."
fail_txt = "The sheds stink of tar and old rope. If she was here, the rain took the rest."
metadata/_custom_type_script = "uid://b7vmcwnbxge0e"

[sub_resource type="Resource" id="Resource_add_trail"]
script = ExtResource("8")
add_flag = Array[ExtResource("4")]([ExtResource("6")])
metadata/_custom_type_script = "uid://ta4rmpl13bdw"

[sub_resource type="Resource" id="Resource_follow"]
script = ExtResource("3")
txt = "Follow the inland road"
actions = Array[ExtResource("1")]([SubResource("Resource_add_trail")])
metadata/_custom_type_script = "uid://0o5ru8obqsel"

[resource]
script = ExtResource("9")
titel = "Missing Mare"
img = ExtResource("10")
description = "The net-sheds behind the harbor are empty. No runaway waits in the tar and rain. Whoever took her did not leave her for the watch."
content = Array[ExtResource("2")]([SubResource("Resource_ask"), SubResource("Resource_wits"), SubResource("Resource_follow")])
open_actions = Array[ExtResource("1")]([SubResource("Resource_gate")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
