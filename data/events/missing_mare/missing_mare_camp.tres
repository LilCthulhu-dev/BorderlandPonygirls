[resource]
script = ExtResource("9")
titel = "Missing Mare"
img = ExtResource("10")
description = "A low fire off the inland road. A cart. Three shapes. In the traces, a dark-haired mare in new tack, gagged so hard the ring cuts her lip.

This is not a runaway camp. This is a sale waiting for a buyer."
content = Array[ExtResource("2")]([SubResource("Resource_hit"), SubResource("Resource_later")])
open_actions = Array[ExtResource("1")]([SubResource("Resource_gate")])
