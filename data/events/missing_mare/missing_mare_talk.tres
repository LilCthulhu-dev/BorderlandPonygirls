[sub_resource type="Resource" id="Resource_back"]
script = ExtResource("14")
metadata/_custom_type_script = "uid://b0g16xoo4jggg"

[sub_resource type="Resource" id="Resource_return_txt"]
script = ExtResource("15")
txt = "You leave the gag out but keep the lead. She goes quiet. The Trading Post is the next argument - and she knows it."
metadata/_custom_type_script = "uid://cjt27rj7fiwsv"

[sub_resource type="Resource" id="Resource_return"]
script = ExtResource("3")
txt = "Take her back to the merchant"
actions = Array[ExtResource("1")]([SubResource("Resource_return_txt")])
metadata/_custom_type_script = "uid://0o5ru8obqsel"

[sub_resource type="Resource" id="Resource_keep"]
script = ExtResource("3")
txt = "Keep her for your stable"
actions = Array[ExtResource("1")]([SubResource("Resource_add"), SubResource("Resource_rep_keep"), SubResource("Resource_kept")])
metadata/_custom_type_script = "uid://0o5ru8obqsel"

[sub_resource type="Resource" id="Resource_free"]
script = ExtResource("3")
txt = "Cut her free"
actions = Array[ExtResource("1")]([SubResource("Resource_gold_free"), SubResource("Resource_rep_free"), SubResource("Resource_done")])
metadata/_custom_type_script = "uid://0o5ru8obqsel"

[sub_resource type="Resource" id="Resource_later"]
script = ExtResource("3")
txt = "Not yet"
actions = Array[ExtResource("1")]([SubResource("Resource_back")])
metadata/_custom_type_script = "uid://0o5ru8obqsel"

[resource]
script = ExtResource("10")
titel = "Missing Mare"
img = ExtResource("11")
description = "You pull the gag. Her mouth is raw. She does not thank you.

“I never took the bit,” she says, voice torn. “They took me off the road. That merchant - if he wants me back, he bought a kidnapping. Please. Don’t walk me to him.”"
content = Array[ExtResource("2")]([SubResource("Resource_return"), SubResource("Resource_keep"), SubResource("Resource_free"), SubResource("Resource_later")])
open_actions = Array[ExtResource("1")]([SubResource("Resource_gate")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
