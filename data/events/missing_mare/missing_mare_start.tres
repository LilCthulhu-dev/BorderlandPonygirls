[resource]
script = ExtResource("9")
titel = "Missing Mare"
img = ExtResource("10")
description = "A sweating merchant catches your sleeve at the Trading Post stable.

“One of my mares bolted toward Harbor Town. I need a warband that can bring her back - or at least find what’s left of the tack. I’ll pay well if she comes home.”"
content = Array[ExtResource("2")]([SubResource("Resource_inspect"), SubResource("Resource_wits"), SubResource("Resource_accept"), SubResource("Resource_decline")])
open_actions = Array[ExtResource("1")]([SubResource("Resource_gate")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
