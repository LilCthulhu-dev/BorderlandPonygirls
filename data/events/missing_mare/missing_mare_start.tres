[sub_resource type="Resource" id="Resource_inspect_txt"]
script = ExtResource("3")
txt = "He describes a human mare, dark hair, cheap tack, one torn blinder. Last seen on the harbor road after a storm.

The sketch is bad. The wax stamp in the corner is worse - the same cheap buyer-mark used by crews who sell fresh stock, not runaways."
metadata/_custom_type_script = "uid://cjt27rj7fiwsv"

[sub_resource type="Resource" id="Resource_inspect"]
script = ExtResource("4")
txt = "Ask for details"
actions = Array[ExtResource("1")]([SubResource("Resource_inspect_txt")])
metadata/_custom_type_script = "uid://0o5ru8obqsel"

[sub_resource type="Resource" id="Resource_wits"]
script = ExtResource("12")
ability = 5
txt = "Read the tack in the sketch"
succes_txt = "The bit in the drawing is new. The straps have no sweat-dark. This mare was never worked. She was taken, then dressed for sale."
fail_txt = "It looks like a runaway. Storm, torn blinder, harbor road. You cannot prove more than that."
metadata/_custom_type_script = "uid://b7vmcwnbxge0e"

[sub_resource type="Resource" id="Resource_to_accept"]
script = ExtResource("5")
event_path = "res://data/events/missing_mare/missing_mare_accept.tres"
metadata/_custom_type_script = "uid://low1eg5crao3"

[sub_resource type="Resource" id="Resource_add_flag"]
script = ExtResource("8")
add_flag = Array[ExtResource("6")]([ExtResource("7")])
metadata/_custom_type_script = "uid://ta4rmpl13bdw"

[sub_resource type="Resource" id="Resource_accept"]
script = ExtResource("4")
txt = "Accept"
actions = Array[ExtResource("1")]([SubResource("Resource_to_accept"), SubResource("Resource_add_flag")])
