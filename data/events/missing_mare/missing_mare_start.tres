[sub_resource type="Resource" id="Resource_yxct2"]
script = ExtResource("3_kesi6")
_btn_text = "Ask for details"
_modal_text = "He describes a human mare, dark hair, cheap tack, one torn blinder. She slipped her lead on the harbor road after a thunderstorm.

Harbor watch sometimes corrals runaways behind the net-sheds until someone pays the fine - or until a warband claims them."

[sub_resource type="Resource" id="Resource_to_accept"]
script = ExtResource("5")
event_path = "res://data/events/missing_mare/missing_mare_accept.tres"
metadata/_custom_type_script = "uid://low1eg5crao3"

[sub_resource type="Resource" id="Resource_add_flag"]
