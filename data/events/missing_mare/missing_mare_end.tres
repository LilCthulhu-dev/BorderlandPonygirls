[sub_resource type="Resource" id="Resource_pay"]
script = ExtResource("6")
amount = "{GOOD_WAGE}"
metadata/_custom_type_script = "uid://b2kag3ewwrnih"

[sub_resource type="Resource" id="Resource_rep_good"]
script = ExtResource("7")
amount = 2
metadata/_custom_type_script = "uid://b4pvlbqjhib4e"

[sub_resource type="Resource" id="Resource_clear"]
script = ExtResource("5")
remove_flag = Array[ExtResource("3")]([ExtResource("4")])
metadata/_custom_type_script = "uid://ta4rmpl13bdw"

[sub_resource type="Resource" id="Resource_return_btn"]
script = ExtResource("9")
txt = "Return her to the merchant"
actions = Array[ExtResource("1")]([SubResource("Resource_pay"), SubResource("Resource_rep_good"), SubResource("Resource_clear")])
metadata/_custom_type_script = "uid://0o5ru8obqsel"

[sub_resource type="Resource" id="Resource_keep_pony"]
script = ExtResource("8")
force_race = 1
force_loyalty = 25
force_arousal = 40
force_xp = 5
metadata/_custom_type_script = "uid://dpu27o7lu670x"

[sub_resource type="Resource" id="Resource_rep_bad"]
script = ExtResource("7")
amount = -5
metadata/_custom_type_script = "uid://b4pvlbqjhib4e"

[sub_resource type="Resource" id="Resource_keep_btn"]
script = ExtResource("9")
txt = "Keep her for your stable"
actions = Array[ExtResource("1")]([SubResource("Resource_keep_pony"), SubResource("Resource_rep_bad"), SubResource("Resource_clear")])
metadata/_custom_type_script = "uid://0o5ru8obqsel"

[sub_resource type="Resource" id="Resource_later"]
script = ExtResource("9")
txt = "Not yet"
metadata/_custom_type_script = "uid://0o5ru8obqsel"

[sub_resource type="Resource" id="Resource_gate"]
script = ExtResource("5")
required_flag = Array[ExtResource("3")]([ExtResource("4")])
metadata/_custom_type_script = "uid://ta4rmpl13bdw"

[resource]
script = ExtResource("10")
titel = "Missing Mare"
description = "You find her behind a net-shed: bit still in, harness twisted, loyalty gone. She flinches when you take the lead.

The merchant’s sketch matches. You can walk her back to the post for the reward - or put her in your own line and live with the talk."
img = ExtResource("11")
content = Array[ExtResource("2")]([SubResource("Resource_return_btn"), SubResource("Resource_keep_btn"), SubResource("Resource_later")])
open_actions = Array[ExtResource("1")]([SubResource("Resource_gate")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
