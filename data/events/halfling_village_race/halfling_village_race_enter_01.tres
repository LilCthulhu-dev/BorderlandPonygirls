[resource]
script = ExtResource("11_qbl3j")
titel = "Halfling Village Derby"
description = "The halfling racemaster is busy directing helpers and inspecting long lists when you approach him about entering the race.

“Another racer?” he asks with pleasant surprise before nodding eagerly. “Of course, {TITLE}. You have the proper racing gear, I assume?”

You confirm that you do, and he keeps nodding. “Excellent! Then you only need to pay the entry fee, and we’ll get you registered.”"
content = Array[ExtResource("2_phmbt")]([SubResource("Resource_fsvla"), SubResource("Resource_be1vt")])
