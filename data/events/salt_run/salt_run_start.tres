actions = Array[ExtResource("1")]([SubResource("Resource_to_decline")])
metadata/_custom_type_script = "uid://0o5ru8obqsel"

[sub_resource type="Resource" id="Resource_gate"]
script = ExtResource("8")
forbidden_flag = Array[ExtResource("6")]([ExtResource("7")])
metadata/_custom_type_script = "uid://ta4rmpl13bdw"

[resource]
script = ExtResource("9")
titel = "Salt Run"
description = "A dock clerk with ink-black fingers flags you down between the fish stalls.

“{TITLE}. I’ve a sealed crate of salt that needs to reach the Goblin Village kitchens before the next feast-day. Pay on delivery. Keep it dry. Don’t let the guards ‘inspect’ half of it into their own pouches.”"
img = ExtResource("10")
content = Array[ExtResource("2")]([SubResource("Resource_inspect"), SubResource("Resource_accept"), SubResource("Resource_decline")])
open_actions = Array[ExtResource("1")]([SubResource("Resource_gate")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
