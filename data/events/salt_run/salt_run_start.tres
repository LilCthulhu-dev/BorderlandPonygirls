[sub_resource type="Resource" id="Resource_inspect_txt"]
script = ExtResource("3")
txt = "The crate is cheap pine, waxed at every seam. A harbor stamp marks it as kitchen salt for inland cooks - not the fine white stuff the empire hoards.

Your mare snorts at the dry smell. If you split it on the road you could sell handfuls at every campfire. The clerk would also know."
metadata/_custom_type_script = "uid://cjt27rj7fiwsv"

[sub_resource type="Resource" id="Resource_inspect"]
script = ExtResource("4")
txt = "Inspect the crate"
actions = Array[ExtResource("1")]([SubResource("Resource_inspect_txt")])
metadata/_custom_type_script = "uid://0o5ru8obqsel"

[sub_resource type="Resource" id="Resource_to_accept"]
script = ExtResource("5")
event_path = "res://data/events/salt_run/salt_run_accept.tres"
metadata/_custom_type_script = "uid://low1eg5crao3"

[sub_resource type="Resource" id="Resource_add_flag"]
script = ExtResource("8")
add_flag = Array[ExtResource("6")]([ExtResource("7")])
metadata/_custom_type_script = "uid://ta4rmpl13bdw"

[sub_resource type="Resource" id="Resource_accept"]
script = ExtResource("4")
txt = "Accept"
actions = Array[ExtResource("1")]([SubResource("Resource_to_accept"), SubResource("Resource_add_flag")])
metadata/_custom_type_script = "uid://0o5ru8obqsel"

[sub_resource type="Resource" id="Resource_to_decline"]
script = ExtResource("5")
event_path = "res://data/events/salt_run/salt_run_decline.tres"
metadata/_custom_type_script = "uid://low1eg5crao3"

[sub_resource type="Resource" id="Resource_decline"]
script = ExtResource("4")
