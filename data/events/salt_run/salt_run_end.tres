script = ExtResource("7")
titel = "Salt Run"
description = "A village quartermaster pries the crate, sniffs, and grins. “Harbor salt. Good. The cooks will stop threatening to boil boots.”

He counts coin into your palm without looking up. “Tell the clerk we got it dry.”"
