[sub_resource type="Resource" id="Resource_mqmyc"]
script = ExtResource("3_jo8wf")
_btn_text = "Inspect the sacks"
_new_content_text = "The sacks are last year's surplus: dry, a little dusty, still good. A torn stitch would leak a trail any hungry camp could follow.

Your lead mare already has her nose in the seam. If you let her, half the levy will be gone before the harbor gates."
single_use = true
metadata/_custom_type_script = "uid://bhikhif1mmeq"

[sub_resource type="Resource" id="Resource_te0br"]
script = ExtResource("8")
add_flag = Array[ExtResource("6")]([ExtResource("7")])
metadata/_custom_type_script = "uid://ta4rmpl13bdw"

[sub_resource type="Resource" id="Resource_0gr2t"]
script = ExtResource("3_jo8wf")
_btn_text = "Accept"
_new_content_text = "The cook knots the last sack and slaps it onto the cart. \"Harbor mill, blue awning, ask for the night miller. Bring back an empty sack if you want another load.\"

Grain dust follows you out of the village."
actions = Array[ExtResource("1")]([SubResource("Resource_te0br")])
end_conversation = true
metadata/_custom_type_script = "uid://bhikhif1mmeq"

[sub_resource type="Resource" id="Resource_nx3u7"]
script = ExtResource("3_jo8wf")
_btn_text = "Decline"
_new_content_text = "The cook shrugs and waves a boy toward the next cart. \"Plenty of hungry roads, {TITLE}. Come back if you change your mind.\""
end_conversation = true
metadata/_custom_type_script = "uid://bhikhif1mmeq"

[sub_resource type="Resource" id="Resource_gate"]
script = ExtResource("8")
forbidden_flag = Array[ExtResource("6")]([ExtResource("7")])
metadata/_custom_type_script = "uid://ta4rmpl13bdw"

[resource]
script = ExtResource("9")
titel = "Grain Levy"
description = "A village cook with flour in his ears plants himself in your path.

\"{TITLE}. Last year's surplus is rotting in the store-hut. Harbor millers will pay for it if it arrives dry. Coin on delivery. Don't let the mares snack the sacks open.\""
img = ExtResource("10")
content = Array[ExtResource("2")]([SubResource("Resource_mqmyc"), SubResource("Resource_0gr2t"), SubResource("Resource_nx3u7")])
open_actions = Array[ExtResource("1")]([SubResource("Resource_gate")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
