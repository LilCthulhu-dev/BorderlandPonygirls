[ext_resource type="Texture2D" uid="uid://ckg3uqw6ae6va" path="res://assets/img/grain_levy.png" id="10"]

[sub_resource type="Resource" id="Resource_inspect_txt"]
script = ExtResource("3")
txt = "The sacks are last year's surplus: dry, a little dusty, still good. A torn stitch would leak a trail any hungry camp could follow.

Your lead mare already has her nose in the seam. If you let her, half the levy will be gone before the harbor gates."
metadata/_custom_type_script = "uid://cjt27rj7fiwsv"

[sub_resource type="Resource" id="Resource_inspect"]
script = ExtResource("4")
txt = "Inspect the sacks"
actions = Array[ExtResource("1")]([SubResource("Resource_inspect_txt")])
metadata/_custom_type_script = "uid://0o5ru8obqsel"

[sub_resource type="Resource" id="Resource_to_accept"]
script = ExtResource("5")
event_path = "res://data/events/grain_levy/grain_levy_accept.tres"
metadata/_custom_type_script = "uid://low1eg5crao3"

[sub_resource type="Resource" id="Resource_add_flag"]
script = ExtResource("8")
add_flag = Array[ExtResource("6")]([ExtResource("7")])
metadata/_custom_type_script = "uid://ta4rmpl13bdw"

[sub_resource type="Resource" id="Resource_accept"]
script = ExtResource("4")
txt = "Accept"
actions = Array[ExtResource("1")]([SubResource("Resource_to_accept"), SubResource("Resource_add_flag")])
metadata/_custom_type_script = "uid://0o5ru8obqsel"

[sub_resource type="Resource" id="Resource_to_decline"]
script = ExtResource("5")
event_path = "res://data/events/grain_levy/grain_levy_decline.tres"
metadata/_custom_type_script = "uid://low1eg5crao3"

[sub_resource type="Resource" id="Resource_decline"]
script = ExtResource("4")
txt = "Decline"
actions = Array[ExtResource("1")]([SubResource("Resource_to_decline")])
metadata/_custom_type_script = "uid://0o5ru8obqsel"

[sub_resource type="Resource" id="Resource_gate"]
script = ExtResource("8")
forbidden_flag = Array[ExtResource("6")]([ExtResource("7")])
metadata/_custom_type_script = "uid://ta4rmpl13bdw"

[resource]
script = ExtResource("9")
titel = "Grain Levy"
img = ExtResource("10")
description = "A village cook with flour in her ears plants herself in your path.

\"{TITLE}. Last year's surplus is rotting in the store-hut. Harbor millers will pay for it if it arrives dry. Coin on delivery. Don't let the mares snack the sacks open.\""
content = Array[ExtResource("2")]([SubResource("Resource_inspect"), SubResource("Resource_accept"), SubResource("Resource_decline")])
open_actions = Array[ExtResource("1")]([SubResource("Resource_gate")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
