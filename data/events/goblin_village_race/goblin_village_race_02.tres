[resource]
script = ExtResource("3_rmi63")
titel = "Goblin Village Scramble"
description = "The goblin racemaster stands behind a scarred wooden table covered in lists, coins, and half-empty mugs. He grins when you ask to enter.

“Another challenger! Good, good. More racers make for a better scramble.” He leans sideways to inspect your equipment.

“You’ve got proper racing gear, so that’s one less thing to argue about. Entry costs {COST_RACE_FEE} gold. Pay up, and we’ll put your name on the list.”"
content = Array[ExtResource("2_h0xh0")]([SubResource("Resource_rmi63"), SubResource("Resource_8mmhc")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
