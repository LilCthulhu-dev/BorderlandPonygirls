[sub_resource type="Resource" id="Resource_hbt8e"]
script = ExtResource("7_nl3oo")
_btn_text = "Bridle"
_modal_text = "You order the girl to kneel, before you get the headharness. You tie her hair into a high ponytail, before you work the web of leather straps around her head. It takes a little while and you can feel her shiver under your fingers.

Finally you come in front of her again. You take the bit-gag from a nearby table, and push it deep into her mouth. She struggles a bit, involuntarily flinching away from you, but you hold her in place, fastening the gag in place, reducing her ability to speak drastically.
"
actions = Array[ExtResource("1_ujcte")]([SubResource("Resource_4cxsg"), SubResource("Resource_bt6ru")])

