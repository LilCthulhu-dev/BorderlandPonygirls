[resource]
script = ExtResource("3_70w0p")
titel = "Outfitting"
description = "The girl stands in the middle of the stable, nervously shifting from foot to foot. She is not fully bound yet, and could try to flee or fight back. Instead she waits, eyes cast down, breathing deliberately.

It’s a good sign. Seems like she has the right mindset of a proper ponygirl."
content = Array[ExtResource("2_n5jve")]([SubResource("Resource_n0yy0"), SubResource("Resource_cqq3o"), SubResource("Resource_qsht7"), SubResource("Resource_hbt8e"), SubResource("Resource_am51c")])
