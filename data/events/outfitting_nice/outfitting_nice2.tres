[sub_resource type="Resource" id="Resource_cqq3o"]
script = ExtResource("7_nl3oo")
_btn_text = "Harness"
_modal_text = "You fetch the harness. You order the girl to kneel, and then you begin to wrap it around her torso. It’s basically a web of black leather straps, with extra support for her tits, and metal rings to connect carts, leashes, saddles, bags or other equipment.

You make sure it all sits tight except for the crotchstrap - that one will become important later. For now you give the horny little beast just a friendly clap to her cunt and leave it as is."
actions = Array[ExtResource("1_ujcte")]([SubResource("Resource_k33yw"), SubResource("Resource_0jh02")])

