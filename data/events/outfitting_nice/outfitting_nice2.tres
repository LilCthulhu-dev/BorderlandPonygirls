[sub_resource type="Resource" id="Resource_qsht7"]
script = ExtResource("7_nl3oo")
_btn_text = "Armbinder"
_modal_text = "There are dozens of ways to bind a ponygirls arms, but with this fresh mare you decide to stick to something simple. You order her to put her arms behind her back, grabbing with her hands onto the opposite elbow.

You make sure her forearms are neatly together, before you wrap it in cloth, and then another layer of leather, which you pull tight and strap into place. However, you are not done yet. You fasten cuffs to her upper arms and connect them with leather straps, until there is no chance for her to get her arms out again.
"
actions = Array[ExtResource("1_ujcte")]([SubResource("Resource_amyi3"), SubResource("Resource_l457m")])

