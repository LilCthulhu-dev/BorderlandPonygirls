[sub_resource type="Resource" id="Resource_n0yy0"]
script = ExtResource("7_nl3oo")
_btn_text = "Boots"
_modal_text = "You order her to sit down on a nearby chair, while you fetch the ponyboots - the most important part of the uniform! You work the heavy, black leather up her legs until just below her knees and tighten the laces until they sit perfectly tight.

Your shaman applies a few sprinkles of a magic potion to shrink the material to perfectly fit the new girl’s foot size. The boots will always be her size, always fit just right, so long you apply more of the potion every couple weeks."
actions = Array[ExtResource("1_ujcte")]([SubResource("Resource_gahty"), SubResource("Resource_7yptl")])

