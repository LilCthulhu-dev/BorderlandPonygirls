[resource]
script = ExtResource("9_nq545")
titel = "Outfitting"
description = "You order the girl to sit back up, before you fasten the last item to her - a nice metal collar. You fit it around her throat and with an ominous click it seals the transformation.

“Now, one last thing,” you say almost solemnly, “you need a new name, then you are done.” You pause, share a glance with the shaman. Then you look back at her. “{PONYNAME} sounds fitting.”

She looks at her, growing even more red than before, but nods slowly. “Perfect,” you exclaim, “{PONYNAME} it is. Now let’s get out and meet with the others.”
"
content = Array[ExtResource("2_3woib")]([SubResource("Resource_5jfom")])
close_actions = Array[ExtResource("1_ajbkw")]([SubResource("Resource_6gd3n")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
