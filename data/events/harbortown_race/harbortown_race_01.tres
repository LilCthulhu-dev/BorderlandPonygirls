[resource]
script = ExtResource("13_nxofj")
titel = "Harbortown Circuit"
description = "You arrive at Harbortown’s racetrack to find the old freight yard transformed. Colorful banners hang between the warehouses, temporary stands rise along the course, and a large crowd has gathered to witness the city’s latest sensation."
content = Array[ExtResource("2_pkmrc")]([SubResource("Resource_gd47x"), SubResource("Resource_pkmrc"), SubResource("Resource_lhalu"), SubResource("Resource_walxc"), SubResource("Resource_6tbqf"), SubResource("Resource_dfvfa")])
open_actions = Array[ExtResource("1_gd47x")]([SubResource("Resource_ma5mm")])
