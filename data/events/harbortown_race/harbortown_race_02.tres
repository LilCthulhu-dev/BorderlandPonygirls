[resource]
script = ExtResource("3_w1lic")
titel = "Harbortown Circuit"
description = "The registration official, an old goblin with eyepatch, barely looks up as you approach his crowded desk.

“Name, warband, and...” He pauses when he recognizes you. “Ah, {TITLE} {NAME}. Here to enter the race, I assume?”

He glances at your racing gear and marks something on his list.

“Everything appears to be in order. The entry fee is {COST_RACE_FEE} gold. Pay here, and report to the preparation area before the starting bell.”"
content = Array[ExtResource("2_78vks")]([SubResource("Resource_djj5w"), SubResource("Resource_xm42m")])
