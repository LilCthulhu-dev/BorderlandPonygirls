[sub_resource type="Resource" id="Resource_ksy1x"]
script = ExtResource("3_4cljs")
_btn_text = "Inspect the Hu-Cows"
_modal_text = "Hu-cows are not your speciality, but you give the beasts a once over. They remind you of your own she-beasts: tall-folk, stripped naked and tied up with armbinders and hoofboots.

But they have really large tit and their nipples are visibly erect and wet, as their intensely sensitive breasts are basically overflowing with milk.

Their eyes are dazed and numb, their cunts dripping wet, and they keep wandering aimlessly. A side effect from the drugs the farmers use to get them lactating and able to digest hay."
