metadata/_custom_type_script = "uid://ta4rmpl13bdw"

[sub_resource type="Resource" id="Resource_43yjr"]
script = ExtResource("7_ibf5f")
_btn_text = "Accept"
_new_content_text = "“Good decision, {TITLE}. My men will get the beasts ready, and you’ll be back on the road within the hour,” the old farmer promises. Sure enough, about an hour later, everything is prepared.

The hu-cows seem slightly confused by the change in their daily routine, but they are far too docile to put up much resistance. Leashes are fastened to their collars, and you assign two of your men to lead them along as your warband sets out."
actions = Array[ExtResource("1_an1av")]([SubResource("Resource_7ynj1")])
end_conversation = true
metadata/_custom_type_script = "uid://bhikhif1mmeq"

[sub_resource type="Resource" id="Resource_1x874"]
script = ExtResource("7_ibf5f")
_btn_text = "Decline"
_new_content_text = "“What a shame,” the old farmer says, shaking his head. “But I respect your decision, {TITLE}.”"
metadata/_custom_type_script = "uid://bhikhif1mmeq"

