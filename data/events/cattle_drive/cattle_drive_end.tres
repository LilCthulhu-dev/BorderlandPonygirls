[resource]
script = ExtResource("6_torkx")
titel = "Cattle Drive"
description = "You meet with the farmer’s contact, a stout halfling merchant.

“He hired a whole warband to move his cattle? The old man really needs to accept that he’s getting too old for this kind of work. Shame he has no sons to take over the business.”

The halfling shakes his head, then waves over a few of his men. “Anyhow, enough dawdling. My men will take over the hu-cows from here. Thanks for your help, {TITLE}.”"
open_actions = Array[ExtResource("1_2uss4")]([SubResource("Resource_x814x"), SubResource("Resource_lkv00"), SubResource("Resource_wv51q")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
