[resource]
script = ExtResource("8")
titel = "Bone Charm"
img = ExtResource("9")
description = "The shaman turns the charm in smoke until the carvings darken. “Cave-mark. Old. Useful.”

He pays, then flicks ash toward your mares. They stand quieter after that."
