[sub_resource type="Resource" id="Resource_ksy1x"]
script = ExtResource("3_e8pnr")
btn_text = "Study the charm"
description = "The charm is a knuckle-bone carved with a spiral and a tiny horseshoe. It does not belong to any living warband you know.

Village shamans pay for cave-marks. They also get angry if you sell them at the wrong stall."
metadata/_custom_type_script = "uid://by8ypobaog261"

[sub_resource type="Resource" id="Resource_cdxyw"]
script = ExtResource("8")
add_flag = Array[ExtResource("6")]([ExtResource("7")])
metadata/_custom_type_script = "uid://ta4rmpl13bdw"

[sub_resource type="Resource" id="Resource_tusve"]
script = ExtResource("3_e8pnr")
btn_text = "Take it to the shaman"
end_conversation = true
description = "You wrap the charm in cloth and tuck it into a saddlebag. The bone is warm, as if it had been held a moment ago.

The village shaman will want it before dusk-talk starts."
actions = Array[ExtResource("1")]([SubResource("Resource_cdxyw")])
metadata/_custom_type_script = "uid://by8ypobaog261"

[sub_resource type="Resource" id="Resource_2rxsd"]
script = ExtResource("3_e8pnr")
btn_text = "Leave it"
end_conversation = true
description = "You leave the charm in the grass. Something in the cave mouth seems to watch you go."
metadata/_custom_type_script = "uid://by8ypobaog261"

[sub_resource type="Resource" id="Resource_gate"]
script = ExtResource("8")
forbidden_flag = Array[ExtResource("6")]([ExtResource("7")])
metadata/_custom_type_script = "uid://ta4rmpl13bdw"

[resource]
script = ExtResource("9")
titel = "Bone Charm"
add_back_to_main = false
description = "Near a scatter of old bones your scout kicks up a carved charm, still warm from someone’s hand.

The cave mouth is close. Whatever dropped this might still be watching. A village shaman would pay to read the marks."
img = ExtResource("10")
content = Array[ExtResource("2")]([SubResource("Resource_ksy1x"), SubResource("Resource_tusve"), SubResource("Resource_2rxsd")])
open_actions = Array[ExtResource("1")]([SubResource("Resource_gate")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
