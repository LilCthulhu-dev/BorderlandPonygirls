[sub_resource type="Resource" id="Resource_u2vlh"]
script = ExtResource("3_456fm")
_btn_text = "Study the charm"
_modal_text = "The charm is a knuckle-bone carved with a spiral and a tiny horseshoe. It does not belong to any living warband you know.Village shamans pay for cave-marks. They also get angry if you sell them at the wrong stall."
