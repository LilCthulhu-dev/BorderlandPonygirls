[sub_resource type="Resource" id="Resource_mqmyc"]
script = ExtResource("11_xybms")
ability = 5
modifier = 10
txt = "Examine the she-beast"
succes_txt = "She is skittish, terrified, and clumsy on her hooves. Combined with the fresh whip marks across her back, this strongly suggests that she was recently kidnapped and forced into slavery.

She certainly won’t be loyal, and if you buy her, word will spread that you purchase forcefully enslaved ponygirls."
fail_txt = "She looks healthy, perhaps a little skittish, but that is to be expected. It is difficult to discern anything else."
metadata/_custom_type_script = "uid://b7vmcwnbxge0e"

