[resource]
script = ExtResource("3_silry")
title = "Halfling Village"
description = "Harbortown is the largest city in the region and the northernmost settlement in the Empire.

Tall walls and watchful guards keep it well protected, while well-stocked shops and a bustling market offer both local goods and rare imports from the south.

Humans and elves are the most common sight, but far from the only one. Tieflings, kobolds, goblins, and even the occasional orc move through the crowds without drawing so much as a second glance."
cheap_items = Array[ExtResource("1_al1pc")]([ExtResource("2_6eo28"), ExtResource("3_a48tm")])
expensive_items = Array[ExtResource("1_al1pc")]([ExtResource("4_aj1b6"), ExtResource("5_028d7"), ExtResource("6_t0ekb")])
