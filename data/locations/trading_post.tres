[resource]
script = ExtResource("2_5ho7t")
title = "Trading Post"
image = ExtResource("1_0rab4")
description = "A handful of sturdy buildings, a well-kept stable, and grim-faced guards - this lonely trading post marks the gateway between the Empire to the south and the wild borderlands to the north.

Nearly all goods entering the Empire from the north or leaving it in that direction pass through this small outpost, making it one of the most important places in the region.

The post was built beside a stream that flows north toward Harbortown. As a result, its tiny pier is far busier than its modest size would suggest."
expensive_items = Array[ExtResource("1_gvkq6")]([ExtResource("2_3veny")])
random_events = Array[ExtResource("2_1xhgw")]([ExtResource("3_q1dao"), ExtResource("4_cp2w7"), ExtResource("6_fair"), ExtResource("8_n2epe"), ExtResource("7_mare"), ExtResource("10_disp"), ExtResource("13_nx16n")])
quest_events = Array[ExtResource("2_1xhgw")]([ExtResource("5_3veny"), ExtResource("9_iron"), ExtResource("11_salv"), ExtResource("7_ia4uo")])
