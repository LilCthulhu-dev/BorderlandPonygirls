[resource]
script = ExtResource("2_5ho7t")
title = "Trading Post"
image = ExtResource("1_0rab4")
description = "A few sturdy-looking buildings, a well-kept stable, a solid wall, and grim-faced guards. The tiny outpost isn’t much to write home about, but it is well defended and secure. Out here, most people are used to the sight of a goblin warband, so no one even looks twice at you or your ponygirls.  You’re just another trader and your she-beasts is nothing but cattle."
