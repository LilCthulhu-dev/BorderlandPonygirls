[resource]
script = ExtResource("3_li3rk")
title = "Which Coven"
description = "You enter a clearing in the swampy forest. Half-dead trees and a dense thorn hedge guard the narrow border between the marsh and the depths of the ancient woods to the northeast.

A heavy fog limits your vision, but a path lit by flickering lanterns leads toward a small village perched on an island in the middle of the marsh.

Its buildings are round, built from grey stone and topped with thatched roofs. Charms and wind chimes hang from the windows and wooden beams, swaying gently in the damp breeze."
cheap_items = Array[ExtResource("1_1hyvp")]([ExtResource("2_c8xtr"), ExtResource("3_xhmke")])
expensive_items = Array[ExtResource("1_1hyvp")]([ExtResource("4_ax8sw"), ExtResource("5_7knee")])
