[resource]
script = ExtResource("1_s87no")
title = "Goblin Village"
image = ExtResource("1_dqvud")
description = "Your home village. Its a sprawling maze of huts and raised walkways, built from rough wood and stone. Thin plumes of smoke rise from countless cookfires, carrying the sharp scent of burned fat and spices.

At the center stand the large stables, sheltering both the residents’ ponygirls and the she-beasts from visiting warbands. Stablehands tend to the ponycunts with quiet dedication, ensuring they are fed, watered, and kept properly horny."
cheap_items = Array[ExtResource("1_to240")]([ExtResource("2_e3v7j"), ExtResource("3_0h381")])
expensive_items = Array[ExtResource("1_to240")]([ExtResource("4_s0q40"), ExtResource("5_t7dvf"), ExtResource("6_ye50s")])
random_events = Array[ExtResource("2_ukn7i")]([ExtResource("9_to240"), ExtResource("3_ukn7i"), ExtResource("13_t7dvf"), ExtResource("12_s0q40"), ExtResource("14_iron"), ExtResource("17_grain"), ExtResource("17_bps6k")])
