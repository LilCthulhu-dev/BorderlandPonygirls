[resource]
script = ExtResource("1_r76jd")
title = "Harbor Town"
image = ExtResource("1_v1mis")
description = "Harbortown is the largest city in the region. Its tall walls, fine buildings, and ever-watchful guard make it both prosperous and well protected.

The market is always bustling, overflowing with goods from across the Imperium. Shops crowd the streets and alleys, offering weapons, tools, reagents, and trade goods from every corner of the world.

Humans are the most common sight, but far from the only one. Elves, kobolds, goblins, and even the occasional orc move through the crowds without drawing so much as a second glance."
cheap_items = Array[ExtResource("1_nwqgs")]([ExtResource("2_jvg1u"), ExtResource("3_ot8nl")])
expensive_items = Array[ExtResource("1_nwqgs")]([ExtResource("4_o5trf"), ExtResource("5_cx0qs")])
