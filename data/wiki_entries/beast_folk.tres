[resource]
script = ExtResource("1_3okor")
description = "All other roughly humanoid peoples, capable of speech and reason, are grouped together as beast-folk: for example, reptiloids, gnolls, and minotaurs. They are usually wild and unpredictable, often hostile toward both tall-folk and wild-folk, and far less involved with the affairs of either."
metadata/_custom_type_script = "uid://bkxhc74auednr"
