[resource]
script = ExtResource("1_nx14r")
description = "Land-squids are terrestrial squids roughly the size and weight of an small elephant. They inhabit caves and other dark, sheltered places, where they use their natural camouflage to remain hidden among the rocks.

Land-squids are ambush predators. They remain motionless until prey comes within reach, then attack with their powerful tentacles. Despite their enormous size, they can move with surprising speed over short distances."
img = ExtResource("1_bc41g")
