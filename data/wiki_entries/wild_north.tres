[resource]
script = ExtResource("1_3nq8p")
description = "To the north of the Borderlands lies a vast, untamed wilderness - an endless expanse of grassland swept by harsh, cold winds.

The Wild North is home to feral orks, goblins, ogres, and other wild-folk and beast-folk who do not abide by the treaties between the Empire and the inhabitants of the Borderlands. They regularly raid south in search of plunder, slaves, and a good fight."
img = ExtResource("1_mta8b")
metadata/_custom_type_script = "uid://bkxhc74auednr"
