[resource]
script = ExtResource("1_mpmxv")
description = "The Borderlands are often called the Gateway to the North. This rough, untamed region lies along the northern edge of the Empire, where rugged mountains and deep forests form a natural choke point between Imperial territory and the seemingly endless grasslands of the Wild North.

Civilization is confined to a handful of well-defended cities and outposts. Beyond their walls lies a primitive and dangerous wilderness crawling with monsters, scoundrels, and savage beasts.

The region is also home to fierce goblin tribes bound to the Empire by a series of treaties. They patrol the wilderness and protect the trade routes. In return, the Empire respects their way of life—including their tradition of enslaving tall-folk as ponygirls—and allows them to enter its cities and trade openly."
img = ExtResource("1_j7jrd")
metadata/_custom_type_script = "uid://bkxhc74auednr"
