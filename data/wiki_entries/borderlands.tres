sub_entries = Array[ExtResource("1_mpmxv")]([ExtResource("3_id1ow"), ExtResource("4_n2yxm"), ExtResource("5_5kpcm")])
description = "The Borderlands are a wild, untamed region along the northern edge of the Empire. Civilization is confined to a handful of well-defended cities and outposts. Beyond their walls lies a primitive and dangerous wilderness crawling with monsters, scoundrels, and savage beasts.

The region is also home to fierce goblin tribes bound to the Empire by an ancient pact. They patrol the wilderness and protect the trade routes. In return, the Empire respects their way of life — including their tradition of enslaving tall folk as ponygirls—and allows them to enter its cities and trade openly."
