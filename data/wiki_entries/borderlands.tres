[resource]
script = ExtResource("1_mpmxv")
description = "The Borderlands are a wild, untamed land on the eastern edge of the Empire. Civilization is confined to a handful of well-defended cities and outposts, but beyond their walls lies a primitive and dangerous wilderness, crawling with monsters, scoundrels, and wild beasts.

The region is also home to fierce goblin tribes, who share an ancient pact with the Empire. The goblins guard the wilderness and defend the trading routes, while the Empire, in turn, respects their way of life - especially their tradition of enslaving tall folk as ponygirls - and allows them to enter its cities and trade openly."
img = ExtResource("1_j7jrd")
metadata/_custom_type_script = "uid://bkxhc74auednr"
