[resource]
script = ExtResource("1_28xga")
description = "The World Seam Mountains form the western border of the known world and are home to many dangerous monsters, including harpies, wyrms, and giants. Yet their mighty flanks offer shelter to dwarfs, who delve deep into the stone in search of riches.

The mountains seem to stretch endlessly north and south, separating the Empire and its neighbours from the mysterious western realms beyond their peaks.

Some say another rich land lies beyond the mountains, while others claim there is nothing but a dead wasteland. Most people, however, spare little thought for a mystery they will never solve. The fact remains that nobody has ever crossed the range and returned to tell the tale."
img = ExtResource("1_ey14n")
metadata/_custom_type_script = "uid://bkxhc74auednr"
